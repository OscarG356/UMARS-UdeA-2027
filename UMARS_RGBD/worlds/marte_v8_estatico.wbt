  # ============================================
# META DE NAVEGACION - UMARS
# ============================================

DEF UMARS_META Solid {
  translation 2.2 0.75 0.01
  name "meta_UMARS"

  children [
    # Borde blanco de la meta
    Shape {
      appearance PBRAppearance {
        baseColor 1 1 1
        roughness 0.8
      }
      geometry Box {
        size 0.55 0.55 0.02
      }
    }

    # Superficie verde
    Transform {
      translation 0 0 0.015
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.05 0.9 0.25
            emissiveColor 0.02 0.2 0.04
            roughness 0.8
          }
          geometry Box {
            size 0.43 0.43 0.02
          }
        }
      ]
    }

    # Centro de la meta
    Transform {
      translation 0 0 0.03
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 1 1 1
            roughness 0.8
          }
          geometry Box {
            size 0.12 0.12 0.02
          }
        }
      ]
    }
  ]
}


