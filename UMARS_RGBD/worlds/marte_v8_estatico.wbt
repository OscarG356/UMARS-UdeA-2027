#VRML_SIM R2025a utf8

# UMARS - MALER: vista superior + RGB + profundidad.

WorldInfo {
  title "UMARS - MALER v8 | Estatico"
  basicTimeStep 32
  coordinateSystem "ENU"
} 

# VISTA 3: Superior, mirando hacia abajo (-Z).
Viewpoint {
  orientation 0 1 0 1.57079632679
  position 0 0 8
  fieldOfView 0.95
  description "Vista superior UMARS"
} 

Background {
  skyColor [
    0.76 0.63 0.5
  ]
}

DirectionalLight {
  direction -0.4 0.4 -1
  intensity 1.4
}

# TERRENO MARCIANO
Solid {
  translation 0 0 -0.06
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.63 0.4 0.26
        roughness 1
        metalness 0
      }
      geometry Box {
        size 6 4 0.12
      }
    }
  ]
  name "terreno_marciano_simplificado"
  boundingObject Box {
    size 6 4 0.12
  }
}

# ROVER UMARS - SUPERVISOR
DEF UMARS_ROVER Robot {
  translation -1.5 0 0.15
  rotation 0 0 1 0
  name "UMARS_rover_Q"
  controller "umars_v8"
  supervisor TRUE

  children [

    # Chasis
    Shape {
      appearance PBRAppearance {
        baseColor 0.13 0.24 0.48
        roughness 0.6
      }
      geometry Box {
        size 0.35 0.3 0.18
      }
    }

    # Marca naranja para indicar el frente (+X)
    Transform {
      translation 0.12 0 0.105
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 1 0.42 0.08
            roughness 0.5
          }
          geometry Box {
            size 0.09 0.065 0.02
          }
        }
      ]
    }

    # VISTA 1: Camara RGB frontal
    Camera {
      translation 0.19 0 0.15
      name "rgb"
      fieldOfView 2.1
      width 320
      height 240
      near 0.05
    }

    # VISTA 2: Sensor de profundidad frontal
    RangeFinder {
      translation 0.19 0 0.15
      name "depth"
      fieldOfView 2.1
      width 160
      height 120
      near 0.05
      minRange 0.05
      maxRange 5.0
    }
    Lidar {
      translation 0 0 0.15
      name "lidar_seguridad"
      horizontalResolution 181
      fieldOfView 4.712389
      numberOfLayers 1
      verticalFieldOfView 0.2
      near 0.05
      minRange 0.05
      maxRange 5.0
      type "fixed"
      projection "cylindrical"
    }
    Display {
      name "lidar_display"
      width 640
      height 360
    }
  ]
}

